# ── 네이버 CalDAV ─────────────────────────────────────────────
# 네이버 아이디(이메일 앞부분만). 예: hanys002
NAVER_ID=your_naver_id
# 네이버 "애플리케이션 비밀번호" (로그인 비밀번호 아님)
# 네이버 > 내정보 > 보안설정 > 애플리케이션 비밀번호 관리에서 발급
NAVER_APP_PASSWORD=xxxxxxxxxxxx
# CalDAV 엔드포인트 (보통 수정 불필요)
NAVER_CALDAV_URL=https://caldav.calendar.naver.com/caldav/

# ── 동기화 범위 ──────────────────────────────────────────────
SYNC_PAST_DAYS=30
SYNC_FUTURE_DAYS=365
CALENDAR_NAME=Naver Calendar
TIMEZONE=Asia/Seoul

# ── 모드 B: 구글 캘린더 직접 upsert ───────────────────────────
# 서비스 계정 JSON 전체를 한 줄로 (GitHub Secrets: GOOGLE_SERVICE_ACCOUNT_JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=
# 대상 구글 보조 캘린더 ID (서비스 계정에 '변경 권한' 공유 필요)
GOOGLE_CALENDAR_ID=
